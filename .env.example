APP_ENV=development
DJANGO_SECRET_KEY=generate-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Local Compose database credentials. If changed, update BOTH values before first startup.
# Percent-encode reserved characters in the DATABASE_URL password.
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://hims:local-development-only@db:5432/hims
REDIS_URL=redis://redis:6379/0
PAYMENT_PROVIDER=development
PAYMENT_SIGNING_KEY=generate-a-separate-long-random-local-secret
SEED_PASSWORD=
