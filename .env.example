APP_ENV=development
DJANGO_SECRET_KEY=generate-a-long-random-local-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Copy your project's SESSION pooler URI from Supabase Dashboard > Connect (port 5432).
# Percent-encode reserved password characters and add ?sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
REDIS_URL=redis://redis:6379/0
PAYMENT_PROVIDER=development
PAYMENT_SIGNING_KEY=generate-a-separate-long-random-local-secret
SEED_PASSWORD=

# Bakong KHQR (only used when PAYMENT_PROVIDER=bakong). Never commit real values; never use VITE_*.
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=Luma Haven
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_CURRENCY=USD
