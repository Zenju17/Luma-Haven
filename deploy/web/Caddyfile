{
	email {$ACME_EMAIL}
}

# SITE_ADDRESS is the public hostname (automatic HTTPS), or ":80" behind another TLS terminator.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# API. Django's own /admin/ site is intentionally NOT proxied: /admin is the Vue admin portal.
	handle /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto {scheme}
			# Django trusts exactly one proxy hop (TRUSTED_PROXY_COUNT=1); replace, never append, client-supplied values.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Uploaded visual assets (shared volume with the backend).
	handle /media/* {
		root * /srv
		file_server
	}

	# Single-page app with history-mode routing.
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
