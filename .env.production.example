# Copy to .env.production on the server (never commit it). Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=production
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Real hostnames only (no wildcard). 127.0.0.1 and backend are used by container health checks.
DJANGO_ALLOWED_HOSTS=hotel.example.com,127.0.0.1,backend
FRONTEND_ORIGIN=https://hotel.example.com
SITE_ADDRESS=hotel.example.com
ACME_EMAIL=ops@example.com

# Managed PostgreSQL (Supabase session pooler, port 5432, sslmode=require).
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

PAYMENT_PROVIDER=bakong
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=Luma Haven
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_CURRENCY=USD

# Optional error reporting (PII is scrubbed before sending).
SENTRY_DSN=
APP_VERSION=
LOG_LEVEL=INFO

# Backups (scripts/backup_db.sh). Files live in the `backups` volume.
BACKUP_KEEP_DAYS=30
